{
  "rules": {
    "units": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true"
    },

    "sessions": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true",

      "$sessionId": {
        ".write": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true && $sessionId != 'dispatch__'"
      }
    },

    "auditLogs": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true",

      "$unitId": {
        ".indexOn": ["timestamp", "clientTime", "eventTime"],

        "$eventId": {
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && ((data.child('timestamp').isNumber() && data.child('timestamp').val() < now - 31536000000) || (!data.child('timestamp').exists() && data.child('clientTime').isNumber() && data.child('clientTime').val() < now - 31536000000))))"
        }
      }
    },

    "auditMetrics": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true"
    },

    "pursuitControl": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true"
    },

    "pursuits": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('enabled').val() == true",
      ".indexOn": ["meta/startedAtClient"]
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    }
  }
}
